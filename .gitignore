# --- dependencies / build artifacts ---
node_modules/
target/
build/
dist/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- editors / OS ---
.DS_Store
*.swp
.idea/
.vscode/
*.iml

# --- secrets / credentials (never commit) ---
.env
.env.*
*.pem
*.key
*id_rsa*
*id_ed25519*
.credentials*
secrets/
!*.example

# --- toolchain / runtimes (large spike downloads) ---
/private/tmp/
rust-toolchain/
.cargo/
rustup/
toolchains/

# --- codebase-memory artifacts ---
.codebase-memory/

# --- design-linter runtime cache (config.json stays tracked) ---
.impeccable/hook.cache.json

# --- spike runtime noise ---
spikes/**/work/
spikes/gate-c/build/
spikes/**/*.db
spikes/**/*.db-shm
spikes/**/*.db-wal

# --- temp evidence / re-runs (keep raw results only via evidence/) ---
evidence/**/tmp/
*.log
nohup.out

# --- model weights & raw data (never commit: large, and re-downloads may differ) ---
# Small deliberate fixtures stay tracked (a few-KB anchor table, a test shard).
# Ambiguous formats (.arrow/.npy/.parquet/.h5) are intentionally NOT banned here:
# several repos track small shards of exactly those on purpose.
/models/
*.gguf
*.safetensors
*.ckpt
*.onnx
*.pt
*.pth
/data/raw/
/data/external/
/data/interim/
/raw/
*.dta
*.sav
*.rds
# --- end model weights & raw data ---
